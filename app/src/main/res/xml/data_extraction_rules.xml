<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+. Only read when the user turned backup on (DiaryBackupAgent); cloud only end-to-end encrypted (also enforced by the agent for API 28-30); keep in sync with backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="." />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
