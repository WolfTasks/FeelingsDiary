<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+. Only read when the user turned backup on (DiaryBackupAgent); keep in sync with backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
